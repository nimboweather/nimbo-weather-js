{
  "name": "nimbo-weather",
  "version": "0.1.1",
  "description": "Client for the Nimbo Weather rain nowcast API: minute-by-minute rain for the next 3 hours in Europe.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:live": "npm run build && node --test test/live.test.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "weather",
    "rain",
    "nowcast",
    "precipitation",
    "radar",
    "forecast",
    "api",
    "europe"
  ],
  "homepage": "https://nimboweather.com/api",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "author": "Nimbo Weather <hello@nimboweather.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimboweather/nimbo-weather-js.git"
  },
  "bugs": {
    "url": "https://github.com/nimboweather/nimbo-weather-js/issues"
  }
}
